{
  "buildCommand": "echo 'Using pre-built files from GitHub'",
  "outputDirectory": "build/web",
  "installCommand": "echo 'No install needed'",
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/app-ads.txt",
      "destination": "/app-ads.txt"
    },
    {
      "source": "/((?!assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
