{
  "buildCommand": "echo 'Using pre-built files from GitHub'",
  "outputDirectory": "build/web",
  "installCommand": "echo 'No install needed'",
  "headers": [
    {
      "source": "/blog/:path*.mdx",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=UTF-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/app-ads.txt",
      "destination": "/app-ads.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "/rss.xml"
    },
    {
      "source": "/blog/java",
      "destination": "/blog/java.html"
    },
    {
      "source": "/blog/python",
      "destination": "/blog/python.html"
    },
    {
      "source": "/blog/ai-basic",
      "destination": "/blog/ai-basic.html"
    },
    {
      "source": "/blog/ai-insight",
      "destination": "/blog/ai-insight.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/apps",
      "destination": "/about/apps.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/((?!assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
